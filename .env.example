# Server environment variables
PORT=3000
# Keep this key on the Render backend only. Never put it in app.js or GitHub Pages.
OPENAI_API_KEY=
# Current default is GPT-5.6 Luna; change only if you intentionally choose another supported model.
OPENAI_MODEL=gpt-5.6-luna
# Optional: restrict CORS to specific origins (comma-separated). Empty/blank keeps CORS open for development.
# ALLOWED_ORIGINS=https://draehalo-art.github.io
# eBay Browse API (V5.3). Copy values from your eBay developer app; keep them on the Render server only.
# EBAY_ENVIRONMENT defaults to sandbox. Set EBAY_ENVIRONMENT=production only with real production keys.
# EBAY_MARKETPLACE_ID defaults to EBAY_US.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
